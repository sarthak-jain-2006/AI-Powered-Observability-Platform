{
  "name": "db-down",
  "category": "database",
  "type": "infra",
  "target": {
    "service": "product-service",
    "container": "product-db"
  },
  "description": "Stops the product database container to simulate total DB outage",
  "inject": {
    "command": "docker stop product-db"
  },
  "recover": {
    "command": "docker start product-db"
  },
  "expectedSymptoms": [
    "product-service 5xx errors",
    "order failures (502)"
  ],
  "detectionSignal": "error_rate spike on product-service + order-service"
}
