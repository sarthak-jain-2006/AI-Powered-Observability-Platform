generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id            Int      @id @default(autoincrement())
  userId        Int
  items         Json
  totalAmount   Float
  status        String   @default("pending")
  failureReason String?
  paymentId     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}