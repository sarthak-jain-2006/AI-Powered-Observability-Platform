generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Payment {
  id             Int      @id @default(autoincrement())
  idempotencyKey String   @unique
  orderId        String
  amount         Float
  status         String   @default("pending")
  failureReason  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}